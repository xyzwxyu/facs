# The application runs on the host; only PostgreSQL runs in Docker.
DATABASE_URL=postgresql+asyncpg://facs:facs_password@127.0.0.1:5432/facs
FACS_IP=0.0.0.0
FACS_PORT=8000
FACS_SOCKET_PATH=/tmp/facs.sock
FACS_MAX_SESSIONS=100000
FACS_MAX_SOAP_BYTES=16777216
FACS_LOG_LEVEL=INFO
# FACS_LOG_FILE=/absolute/path/to/facs.log
FACS_DB_POOL_SIZE=10
FACS_DB_MAX_OVERFLOW=20
FACS_TASK_LEASE_SECONDS=900
FACS_TASK_MAX_RETRIES=3

# Remote management (disabled unless FACS_MANAGE_IP is set). The management
# endpoint serves HTTPS APIs and WSS events with bearer-token authentication.
# FACS_MANAGE_IP=127.0.0.1
# FACS_MANAGE_PORT=8443
# FACS_TLS_CERT=/absolute/path/to/acs.crt
# FACS_TLS_KEY=/absolute/path/to/acs.key
# FACS_ADMIN_TOKEN=generate-a-random-secret-with-at-least-32-characters

# Optional standalone CLI defaults (use on a remote CLI host, not the ACS).
# FACS_CLI_URL=https://acs.example.com:8443
# FACS_CA_FILE=/absolute/path/to/private-ca.pem
