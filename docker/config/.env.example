# FACS Configuration - Copy to .env and customize

# Server Configuration
FACS_IP=0.0.0.0
FACS_PORT=8000
FACS_LOG_LEVEL=INFO

# PostgreSQL Configuration (required)
DATABASE_URL=postgresql://facs:facs_password@postgres:5432/facs
POSTGRES_USER=facs
POSTGRES_PASSWORD=facs_password
POSTGRES_DB=facs

# Optional: Production settings
# FACS_DEBUG=false
# FACS_WORKERS=4
# FACS_MAX_CONNECTIONS=1000
